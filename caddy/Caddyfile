{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip zstd

  @api path /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy backend:3000
  }

  @uploads path /uploads/*
  handle @uploads {
    reverse_proxy backend:3000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
